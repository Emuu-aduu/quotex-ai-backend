# Server Mode
DEBUG=true

# GitHub Configuration (Trust Engine & Commit)
GITHUB_TOKEN=your_github_personal_access_token_here
REPO_OWNER=your_github_username_here
REPO_NAME=your_repository_name_here

# Security & API Key
API_KEY=your_secure_api_key_here

# Backend Health & Monitoring
BACKEND_HEALTH_URL=http://127.0.0.1:8000/health
BACKEND_FALLBACK_URL=http://127.0.0.1:8000/
CHECK_INTERVAL=30

# CORS Allowed Origins (Comma separated for production)
ALLOWED_ORIGINS=http://localhost:3000,https://yourfrontenddomain.com

# Custom Flags (Spaces removed for valid env parsing)
ENABLE_TEST_SIGNAL=true